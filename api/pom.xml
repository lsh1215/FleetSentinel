<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>io.fleetsentinel</groupId>
  <artifactId>api</artifactId>
  <version>0.1.0</version>
  <name>FleetSentinel API</name>
  <description>ClickHouse 질의 + SSE 실시간 푸시. 대시보드가 목업 대신 이걸 본다</description>

  <properties>
    <!-- 게이트웨이와 같은 런타임(SDD §4.1 "Java 버전이 모듈마다 다르다"). -->
    <java.version>21</java.version>
    <clickhouse.jdbc.version>0.9.0</clickhouse.jdbc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- SSE 는 spring-boot-starter-web 의 SseEmitter 로 충분하다.
         WebSocket 이 아닌 이유 — 서버→클라이언트 단방향이고 재연결·재개가
         프로토콜에 있다(SDD 기술 스택). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.clickhouse</groupId>
      <artifactId>clickhouse-jdbc</artifactId>
      <version>${clickhouse.jdbc.version}</version>
      <classifier>all</classifier>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
